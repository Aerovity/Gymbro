# ---------- Mode ----------
DEMO_MODE=0                    # 1 = analysis API routes return fixtures; client uses cached pipeline
MOCK_AI=0                      # 1 = analysis route handlers return fixtures (used by tests/e2e)

# ---------- NVIDIA / Cosmos (provider chain order: COSMOS -> NEMOTRON -> GPT) ----------
COSMOS_BASE_URL=               # hackathon COSMOS3_REASON_URL, or http://localhost:8000 (self-hosted NIM)
COSMOS_API_KEY=                # hackathon GPU_BEARER_TOKEN (blank for local NIM)
COSMOS_MODEL=                  # blank = auto-discover via /v1/models (e.g. nvidia/cosmos3-nano-reasoner)
COSMOS_INPUT_MODE=video_frames # video_frames | video_url | image_frames
COSMOS_FPS=4
COSMOS_TIMEOUT_MS=35000
COSMOS_REASONING=0             # 1 = append <think> format instruction

NVIDIA_API_KEY=                # build.nvidia.com key (nvapi-...) for the hosted Nemotron Omni fallback
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NEMOTRON_TIMEOUT_MS=40000

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-6.1-sol
OPENAI_PICK_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium            # low|medium|high|auto
OPENAI_IMAGE_INPUT_FIDELITY=           # leave blank unless verified supported
OPENAI_TTS_MODEL=                      # blank = browser speechSynthesis
OPENAI_TTS_VOICE=onyx
OPENAI_TIMEOUT_MS=60000

# ---------- VAST indexed workout library (off by default) ----------
VAST_ENABLED=0
VAST_BASE_URL=                 # VSS retrieval service root, NOT the Cosmos inference URL
VAST_WORKOUT_TAG=              # exact tag of an existing indexed gym collection
VAST_APP_ACCESS_KEY=           # separate random 32+ character team key; do not use provider credentials
VAST_BEARER_TOKEN=             # either a VSS token, or username + password below
VAST_USERNAME=
VAST_PASSWORD=
VAST_ALLOW_HTTP=0              # only 1 for a trusted private workshop/local HTTP connection

# ---------- W&B Weave metadata tracing (off by default) ----------
WEAVE_ENABLED=0
WANDB_API_KEY=
WEAVE_PROJECT=                # entity/project
WEAVE_TRACE_BASE_URL=https://trace.wandb.ai
WEAVE_TIMEOUT_MS=750           # total export deadline; 100-2000 ms

# ---------- Optional ----------
YOLO_URL=

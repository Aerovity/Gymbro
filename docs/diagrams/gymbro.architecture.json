  "cards": [
    {
      "dot": "cyan",
      "title": "Analysis stays bounded",
      "items": [
        "Raw upload stays in the browser; sampled JPEGs and measurements go to the analysis API.",
        "Scan tries Cosmos → Nemotron → GPT vision; local pose/rules and a target skeleton cover failures.",
        "Edited images return for local remeasurement. Session results have no database or durable history."
      ]
    },
    {
      "dot": "amber",
      "title": "Sponsor status",
      "items": [
        "VAST search/playback and Weave export are implemented but off by default; live acceptance is pending.",
        "VAST uses an existing indexed collection; analysis uploads are not indexed automatically.",
        "Weave exports allowlisted metadata only; export failure does not fail the analysis."
      ]
    },
    {
      "dot": "slate",
      "title": "Evidence and proposed hosting",
      "items": [
        "Source-linked implementation at e65f21e. The diagram does not prove live provider connectivity.",
        "Cached demo reports are synthetic; the AFTER placeholder is a later frame from the original clip.",
        "CoreWeave GPU hosting is proposed for the Cosmos endpoint. No GPU deployment is provisioned."
      ]
    }
